{
  "manifest_version": 3,
  "name": "Chat Exporter",
  "version": "2.0.0",
  "description": "Xuất lịch sử chat từ Instagram, Zalo",
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://chat.zalo.me/*",
    "https://*.zalo.me/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/direct/*",
        "https://chat.zalo.me/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "https://www.instagram.com/*",
        "https://chat.zalo.me/*",
        "https://*.zalo.me/*"
      ]
    }
  ]
}
